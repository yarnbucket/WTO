    "capture_day": "Tuesday",
    "comparison_day": "following Tuesday",
    "tuesday_snapshot": "Capture the upcoming week's available consensus spread markets exactly as published on Tuesday.",
    "comparison": "On the following Tuesday, compare each saved Tuesday spread with the verified closing spread and final ATS result for the same game.",
    "provider_policy": "Use one clearly identified reliable provider per snapshot. Never mix providers within a snapshot.",
    "unavailable_policy": "Omit an unavailable market value or store it as null. Never invent a spread, price, provider, or timestamp.",
    "preservation_policy": "Tuesday snapshots are immutable. Later comparisons are appended without altering the original snapshot.",
    "spread_convention": "Store the favorite separately and store its spread from the favorite perspective as a negative number.",
    "ats_grading": "Add the stored negative spread to the favorite's final score and compare the adjusted score with the underdog's final score."
  },
